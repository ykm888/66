/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "SL-3000 NOR-Boot Safe-Recovery";
	compatible = "sl,3000-emmc", "mediatek,mt7981";

	chosen {
		/* 物理对齐：PARTLABEL 必须匹配 filogic.mk 中的 -N production */
		/* 增加 rw 参数确保根文件系统可写，物理锁定 console 输出 */
		bootargs = "console=ttyS0,115200n1 loglevel=8 earlycon=uart8250,mmio32,0x11002000 root=PARTLABEL=production rootwait rw rootfstype=f2fs,squashfs";
	};

	/* 物理锁定：救砖模式强制定义 512MB 运行内存 */
	/* 待救砖成功后，将 0x20000000 改为 0x40000000 即可解锁 1024M */
	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x20000000>;
	};

	leds {
		compatible = "gpio-leds";
		status_red_led: led-0 { label = "red:status"; gpios = <&pio 10 GPIO_ACTIVE_LOW>; };
		status_green_led: led-1 { label = "green:status"; gpios = <&pio 11 GPIO_ACTIVE_LOW>; };
		status_blue_led: led-2 { label = "blue:status"; gpios = <&pio 12 GPIO_ACTIVE_LOW>; };
	};

	gpio-keys {
		compatible = "gpio-keys";
		reset { 
			label = "reset"; 
			linux,code = <KEY_RESTART>; 
			gpios = <&pio 1 GPIO_ACTIVE_LOW>; 
			debounce-interval = <60>;
		};
	};
};

/* 网络物理对齐：2.5G 网口与 MT7531 交换机 */
&eth {
	status = "okay";
	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
		fixed-link { speed = <2500>; full-duplex; pause; };
	};

	gmac1: mac@1 { status = "disabled"; };

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;
		switch@0 {
			compatible = "mediatek,mt7531";
			reg = <31>;
			reset-gpios = <&pio 39 GPIO_ACTIVE_LOW>;
			reset-delay-us = <10000>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 { reg = <0>; label = "lan1"; };
				port@1 { reg = <1>; label = "lan2"; };
				port@2 { reg = <2>; label = "lan3"; };
				port@3 { reg = <3>; label = "wan"; };
				port@6 {
					reg = <6>; label = "cpu"; ethernet = <&gmac0>;
					phy-mode = "2500base-x";
					fixed-link { speed = <2500>; full-duplex; pause; };
				};
			};
		};
	};
};

/* eMMC 物理对齐：8位总线模式 */
&mmc0 {
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <52000000>;
	non-removable;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	status = "okay";
};

&pio {
	mmc0_pins_default: mmc0-pins-default { mux { function = "flash"; groups = "emmc_45"; }; };
	mmc0_pins_uhs: mmc0-pins-uhs { mux { function = "flash"; groups = "emmc_45"; }; };
};
