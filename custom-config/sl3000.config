#
# SL-3000 救砖稳健版 (512MB 物理锁定配置) - 3版终极修复
#

# --- 硬件目标定义 (Target System) ---
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_ykm888_sl-3000=y

# --- 内核版本锁定 (物理回归 5.15 稳定分支) ---
CONFIG_LINUX_5_15=y

# --- 512MB 物理兼容性修正 (3版深度锁定) ---
# 强制开启 DMA32 寻址，确保 WiFi 驱动在 512MB 环境下不溢出
CONFIG_ZONE_DMA32=y
# 物理屏蔽大内存寻址参数（由 diy-part2.sh 进一步二次清理）
# CONFIG_ARM64_VA_BITS_39 is not set
# CONFIG_PGTABLE_LEVELS is not set

# --- 3 版零件包名物理对齐 ---
# 必须与 package/boot/ 下 Makefile 定义的 PKG_NAME 严格一致
CONFIG_PACKAGE_uboot-mediatek=y
CONFIG_PACKAGE_uboot-mediatek-mt7981-nor-ddr4=y
CONFIG_PACKAGE_arm-trusted-firmware-mediatek=y
CONFIG_PACKAGE_arm-trusted-firmware-mediatek-mt7981-nor-ddr4=y

# --- 核心源头修复：物理斩断 WiFi 认证循环依赖 ---
# 彻底锁定唯一零件，这是解决 "recursive dependency detected" 的物理关键
CONFIG_PACKAGE_wpad-mesh-openssl=y
# 显式禁用所有引起冲突的变体
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpa-supplicant is not set
# CONFIG_PACKAGE_wpa-supplicant-mesh-openssl is not set
# CONFIG_PACKAGE_wpa-supplicant-openssl is not set
# CONFIG_PACKAGE_wpa-cli is not set

# --- eMMC 存储驱动全家桶 (128G 物理支持) ---
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_block-mount=y

# --- 硬件加速与网络零件 ---
CONFIG_PACKAGE_kmod-mtk-eth-warp=y
CONFIG_PACKAGE_kmod-mtk-ppe=y
CONFIG_PACKAGE_kmod-mt7531=y
CONFIG_PACKAGE_luci-app-turboacc=y

# --- 基础管理与 UI (含 DIY-Part1 注入插件) ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-easymesh=y
CONFIG_PACKAGE_luci-app-vssr=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-theme-argon=y

# --- 3 版物理优化：体积与性能平衡 ---
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_SSTRIP=y
# CONFIG_USE_STRIP is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
