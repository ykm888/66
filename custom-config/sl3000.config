# --- SL-3000 硬件目标定义 ---
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-nor-emmc=y

# --- 内核版本锁定 (关键：对齐你日志中的 6.12 路径) ---
CONFIG_LINUX_6_12=y
CONFIG_TESTING_KERNEL=y

# --- 物理零件对齐：调用修复后的 U-Boot (PKG_NAME:=uboot-mediatek) ---
# 只有启用这一项，你修改的 package/boot/uboot-mediatek/Makefile 才会生效
CONFIG_PACKAGE_uboot-mediatek=y
CONFIG_UBOOT_MEDIATEK_MT7981_SL_3000_NOR_EMMC=y

# --- 救砖全家桶核心零件 (ATF/BL2) ---
CONFIG_PACKAGE_trusted-firmware-a-mtk-library=y
CONFIG_PACKAGE_trusted-firmware-a-mt7981-nor-ddr4=y

# --- 1024M 运行内存物理补丁 ---
# 确保 64 位内核能够完整寻址 1GB 空间，防止地址溢出
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_40=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ZONE_DMA32=y

# --- 存储与物理驱动 (eMMC 读写支持) ---
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_resize2fs=y

# --- 网络与交换机 (2.5G 网口驱动) ---
CONFIG_PACKAGE_kmod-mt7531=y
CONFIG_PACKAGE_kmod-mtk-eth-warp=y

# --- 基础系统与 LUCI 界面 ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-vssr=y

# --- 编译优化参数 ---
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_STRIP=y
CONFIG_USE_SSTRIP=y
# 允许为单个设备生成独立的 rootfs 镜像
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
