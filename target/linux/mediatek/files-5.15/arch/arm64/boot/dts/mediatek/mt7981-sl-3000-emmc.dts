/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "SL-3000 NOR-Boot 1024M Final";
	compatible = "sl,3000-emmc", "mediatek,mt7981";

	chosen {
		/* 物理对齐：指定控制台并锁定 eMMC 上的 production 分区作为根文件系统 */
		bootargs = "console=ttyS0,115200n1 loglevel=8 earlycon=uart8250,mmio32,0x11002000 root=PARTLABEL=production rootwait rootfstype=squashfs,f2fs";
	};

	memory {
		/* 物理锁定：精确定义 1024M (1GB) 内存起始与长度 */
		device_type = "memory";
		reg = <0 0x40000000 0 0x40000000>;
	};

	leds {
		compatible = "gpio-leds";
		status_red_led: led-0 { label = "red:status"; gpios = <&pio 10 GPIO_ACTIVE_LOW>; };
		status_green_led: led-1 { label = "green:status"; gpios = <&pio 11 GPIO_ACTIVE_LOW>; };
		status_blue_led: led-2 { label = "blue:status"; gpios = <&pio 12 GPIO_ACTIVE_LOW>; };
	};

	gpio-keys {
		compatible = "gpio-keys";
		reset { label = "reset"; linux,code = <KEY_RESTART>; gpios = <&pio 1 GPIO_ACTIVE_LOW>; };
		mesh { label = "mesh"; gpios = <&pio 0 GPIO_ACTIVE_LOW>; linux,code = <BTN_9>; linux,input-type = <EV_SW>; };
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&uart0 { status = "okay"; };
&watchdog { status = "okay"; };

/* 物理网络架构修复：双 MAC 映射提高 1024M 内存环境下的吞吐 */
&eth {
	status = "okay";
	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
		fixed-link { speed = <2500>; full-duplex; pause; };
	};

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "2500base-x";
		fixed-link { speed = <2500>; full-duplex; pause; };
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;
		switch@0 {
			compatible = "mediatek,mt7531";
			reg = <31>;
			reset-gpios = <&pio 39 0>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 { reg = <0>; label = "lan1"; };
				port@1 { reg = <1>; label = "lan2"; };
				port@2 { reg = <2>; label = "lan3"; };
				/* 物理隔离：将 WAN 口绑定到第二路 MAC (gmac1) */
				port@3 { reg = <3>; label = "wan"; ethernet = <&gmac1>; };
				port@6 {
					reg = <6>;
					label = "cpu";
					ethernet = <&gmac0>;
					phy-mode = "2500base-x";
					fixed-link { speed = <2500>; full-duplex; pause; };
				};
			};
		};
	};
};

&hnat {
	mtketh-wan = "eth1";
	mtketh-lan = "eth0";
	mtketh-ppd = "eth1";
	mtketh-max-gmac = <2>;
	status = "okay";
};

&xhci {
	mediatek,u3p-dis-msk = <0x0>;
	phys = <&u2port0 PHY_TYPE_USB2>, <&u3port0 PHY_TYPE_USB3>;
	status = "okay";
};

/* 物理存储修复：引导在 NOR，内核必须通过 mmc0 接管 eMMC 上的数据 */
&mmc0 {
	bus-width = <8>;
	cap-mmc-highspeed;
	/* 1.8V 模式是 HS200 的物理前提，如果主板供电不稳请注释掉下面两行 */
	mmc-hs200-1_8v;               
	max-frequency = <200000000>;   
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	vmmc-supply = <&reg_3p3v>;
	status = "okay";
};

&pio {
	mmc0_pins_default: mmc0-pins-default {
		mux { function = "flash"; groups = "emmc_45"; };
	};
	mmc0_pins_uhs: mmc0-pins-uhs {
		mux { function = "flash"; groups = "emmc_45"; };
	};
};
