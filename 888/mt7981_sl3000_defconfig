# --- 【物理核心：1MB 救砖布局修正】 ---
# 1. 物理寻址死锁：告诉 U-Boot 自身位于 Flash 的 1MB 偏移处
CONFIG_SYS_U_BOOT_OFFS=0x100000

# 2. MTD 分区定义：bl2(1M) + fip(2M) + env(64K)
CONFIG_MTDIDS_DEFAULT="nor0=nor0"
CONFIG_MTDPARTS_DEFAULT="nor0:1M(bl2),2048k(fip),64k(u-boot-env),-(factory)"

# 3. 环境变量物理对齐：位于 1M + 2M = 3M ($0x300000) 处
CONFIG_ENV_IS_IN_MTD=y
CONFIG_ENV_MTD_DEV="u-boot-env"
CONFIG_ENV_OFFSET=0x300000
