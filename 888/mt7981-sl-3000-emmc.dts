/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "SL-3000 SPI-NOR 32MB / 512MB DDR4";
	compatible = "sl,3000-spi-nor", "sl,3000-emmc", "mediatek,mt7981";

	aliases {
		serial0 = &uart0;
		led-boot = &status_green_led;
		led-failsafe = &status_red_led;
		led-running = &status_green_led;
		led-upgrade = &status_blue_led;
		label-mac-device = &gmac0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0,115200n1 loglevel=8 earlycon=uart8250,mmio32,0x11002000 root=PARTLABEL=production rootwait rw rootfstype=f2fs,squashfs,ext4";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x20000000>; /* 512MB DDR4 */
	};

	/* 1.8V 稳压器，用于 eMMC vqmmc-supply */
	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	leds {
		compatible = "gpio-leds";

		status_red_led: status-red {
			label = "red:status";
			gpios = <&pio 10 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		status_green_led: status-green {
			label = "green:status";
			gpios = <&pio 11 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};

		status_blue_led: status-blue {
			label = "blue:status";
			gpios = <&pio 12 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys";
		#address-cells = <1>;
		#size-cells = <0>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>; /* 硬件标准低电平触发 */
			debounce-interval = <20>; /* 缩短防抖时间，提高触发灵敏度 */
			linux,input-type = <1>; /* 明确为按键类型，OpenWrt 优先识别 */
			wakeup-source; /* 标记为唤醒源，确保上电时能检测到按键 */
		};
	};
};

/* SPI-NOR 闪存分区布局（适配 32MB Flash） */
&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <52000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x0 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "Config";
				reg = <0x100000 0x80000>;
				read-only;
			};

			partition@180000 {
				label = "Factory";
				reg = <0x180000 0x200000>;
				read-only;
			};

			partition@380000 {
				label = "FIP";
				reg = <0x380000 0x200000>;
				read-only;
			};

			partition@580000 {
				label = "firmware";
				reg = <0x580000 0x1A80000>; /* 0x580000 ~ 0x2000000 */
			};

			partition@1e80000 {
				label = "Product";
				reg = <0x1e80000 0x20000>;
			};

			partition@1ea0000 {
				label = "Custom";
				reg = <0x1ea0000 0x160000>;
			};
		};
	};
};

/* eMMC 链路 */
&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <52000000>;
	cap-mmc-highspeed;
	cap-mmc-hw-reset;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	non-removable;
	no-sd;
	no-sdio;
};

/* 网络配置 */
&eth {
	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;

		switch@0 {
			compatible = "mediatek,mt7531";
			reg = <31>;
			reset-gpios = <&pio 39 GPIO_ACTIVE_LOW>;
			reset-delay-us = <10000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 { reg = <0>; label = "lan1"; };
				port@1 { reg = <1>; label = "lan2"; };
				port@2 { reg = <2>; label = "lan3"; };
				port@3 { reg = <3>; label = "wan"; };

				port@6 {
					reg = <6>;
					label = "cpu";
					ethernet = <&gmac0>;
					phy-mode = "2500base-x";
					fixed-link {
						speed = <2500>;
						full-duplex;
						pause;
					};
				};
			};
		};
	};
};

&pio {
	spi0_flash_pins: spi0-pins {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};
		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			bias-pull-up;
		};
	};

	mmc0_pins_default: mmc0-pins-default {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
		conf-pu {
			pins = "EMMC_RSTB";
			bias-pull-up;
		};
	};

	mmc0_pins_uhs: mmc0-pins-uhs {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};

	/* 额外配置 Reset 键引脚为上拉，确保按键未按下时电平稳定 */
	reset_pin_conf: reset-pin-conf {
		mux {
			function = "gpio";
			groups = "gpio1";
		};
		conf-pu {
			pins = "GPIO1";
			bias-pull-up; /* 未按按键时为高电平，按下为低电平，触发逻辑清晰 */
			drive-strength = <8>; /* 增强驱动能力，避免电平漂移导致检测失败 */
		};
	};
};

/* 启用核心外设 + 加载 Reset 键引脚配置 */
&uart0 { status = "okay"; };
&watchdog { status = "okay"; };
&reg_3p3v { status = "okay"; };
&reg_1p8v { status = "okay"; };
&pio { pinctrl-0 = <&reset_pin_conf>; }; /* 强制加载 Reset 键引脚配置 */
