# 1. 目标平台与设备对齐
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_mt7981_sl3000_emmc=y

# 2. 硬件物理特性补丁 (1GB RAM + MT7976 Wi-Fi)
CONFIG_TARGET_RAM_SIZE_1024=y
CONFIG_PACKAGE_kmod-mt798x-phy-mt7976=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-low-power-firmware=y

# 3. 存储与文件系统 (支持 eMMC + F2FS/EXT4)
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci-mtk=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_block-mount=y

# 4. 救砖核心工具 (串口调试、磁盘管理、环境编辑)
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_ttyd=y

# 5. 基础界面与中文支持 (防止救砖时误操作)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 6. 系统瘦身优化 (针对 32MB SPI-NOR 救砖分区)
CONFIG_CLEAN_IPKG=y
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_KMOD_SYMTAB=n

# 7. 禁用冗余/冲突插件
# CONFIG_PACKAGE_homeproxy is not set
# CONFIG_PACKAGE_strongswan is not set
# CONFIG_PACKAGE_libreswan is not set
