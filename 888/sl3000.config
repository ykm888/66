# =================================================================
# 目标平台设置 (MT7981 Filogic 820)
# =================================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# 必须对齐 mt7981_sl3000.mk 中的 Device 定义
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-emmc=y

# =================================================================
# 1GB 大内存物理优化 (内核级)
# =================================================================
CONFIG_TARGET_RAM_SIZE_1024=y
# 禁用低内存限制，允许更多缓存以提升吞吐
CONFIG_LOW_MEMORY_FOOTPRINT=n
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_PRINTK=y

# =================================================================
# 物理硬件精简：移除所有 USB 相关驱动 (针对无 USB 硬件)
# =================================================================
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_usbutils is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set

# =================================================================
# 网络与 Wi-Fi 驱动 (MT7981B + MT7976 组合)
# =================================================================
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt798x-phy-mt7976=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_wpad-openssl=y
# 救砖必备：允许强制开启无线以防网口损坏
CONFIG_PACKAGE_luci-app-mtwifi=y

# =================================================================
# 32MB SPI-NOR 存储与分区管理
# =================================================================
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_mtd-utils-flashcp=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_fdisk=y
# 支持 F2FS (如果以后挂载 eMMC 需要)
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y

# =================================================================
# 救砖必备工具 (轻量化)
# =================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# 串口终端工具 (Web 端执行命令)
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y

# =================================================================
# 系统瘦身与编译优化 (确保 .itb 不超过 28MB)
# =================================================================
CONFIG_CLEAN_IPKG=y
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_KERNEL_GZIP=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -march=armv8-a+crypto+crc"
# 禁用不常用的内核符号表以节省空间
CONFIG_KMOD_SYMTAB=n
