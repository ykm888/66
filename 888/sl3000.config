# --- 1. 物理目标定义 (Target System) ---
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_ykm888_sl-3000=y

# --- 2. 引导零件工厂 (对齐 DDR4 & 救砖目标) ---
# 锁定底层 ATF，确保 DDR4 训练成功 (虽物理内存1G，但此处锁定DDR4协议)
CONFIG_PACKAGE_arm-trusted-firmware-mediatek=y
CONFIG_PACKAGE_arm-trusted-firmware-mediatek-mt7981-nor-ddr4=y

# 锁定 U-Boot，必须匹配你 Makefile 里的专属救砖目标名
CONFIG_PACKAGE_uboot-mediatek=y
CONFIG_PACKAGE_uboot-mediatek-mt7981_sl3000_nor=y

# --- 3. 存储与分区硬化 (32MB 闪存物理边界) ---
# 核心：设置 PARTSIZE 为 24MB，适配 32MB 物理总空间，防止物理溢出
CONFIG_TARGET_ROOTFS_PARTSIZE=24
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 开启 eMMC 128GB 物理驱动支持 (RootFS在NOR，eMMC作为扩展盘)
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_block-mount=y

# 文件系统支持 (适配 eMMC 128GB)
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_parted=y

# --- 4. 内存与性能硬化 (降级锁定 512MB RAM 策略) ---
# 开启 64 位支持是物理前提
CONFIG_ARCH_64BIT=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y

# --- 5. 网络加速与驱动 ---
CONFIG_PACKAGE_kmod-mtk-eth-warp=y
CONFIG_PACKAGE_kmod-mtk-ppe=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y

# --- 6. 无线与隔离 (解决 WPAD 物理冲突) ---
CONFIG_PACKAGE_wpad-mesh-openssl=y
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-basic is not set

# --- 7. UI 与基本中文环境 ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-easymesh=y

# --- 8. 调试质量控制 (串口早期输出) ---
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_USE_SSTRIP=y
