CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-spi-nor=y

# ====================== SPI NOR Flash 救砖必需 ======================
CONFIG_PACKAGE_kmod-spi-mtk-v2=y
CONFIG_PACKAGE_kmod-spi-dev=y
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MEM=y
CONFIG_MTD_PARTITIONS=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_ROOTFS_ROOT_DEV=y

# ====================== MT7981 网络驱动 ======================
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt7531=y
CONFIG_PACKAGE_kmod-mt7981-eth=y

# ====================== 基础系统 & 救砖工具 ======================
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_uboot-envtools-mtk=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_spi-utils=y
CONFIG_PACKAGE_mtd-utils=y

# ====================== 系统增强 ======================
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_bash=y

# ====================== 强制禁用升级包（核心） ======================
CONFIG_SYSUPGRADE=n
CONFIG_SYSUPGRADE_INFO=n
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_ISO=n
CONFIG_TARGET_UBIFS=n

# ====================== 关闭调试（正式固件必需） ======================
# CONFIG_DEVEL is not set
# CONFIG_AUTOREBUILD is not set
# CONFIG_BUILD_LOG is not set
