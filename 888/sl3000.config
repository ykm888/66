# =========================================================
# SL-3000 (MT7981) Physical Hardening Config (Full Version)
# Target: 1MB FIP Offset + DDR4 + 32MB NOR + eMMC Extension
# =========================================================

# --- 1. 物理目标定义 (Target System) ---
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_mediatek_mt7981-rfb-flash=y

# --- 2. 引导零件工厂 (底层对齐：包名像素级修正) ---
# 【修正核心】：包名必须严格对应 Makefile 中的定义，否则会被 Skipping
# 对应 atf-Makefile 中的 TFA_TARGETS:=mt7981-sl3000-nor
CONFIG_PACKAGE_arm-trusted-firmware-mediatek-mt7981-sl3000-nor=y

# 对应 uboot-Makefile 中的 UBOOT_TARGETS:=mt7981_sl3000
CONFIG_PACKAGE_uboot-mediatek-mt7981_sl3000=y

# --- 3. 存储与分区硬化 (32MB 闪存物理边界) ---
# 核心：设置 PARTSIZE 为 24MB，适配 32MB 物理总空间，留出 BL2/FIP/Factory 空间
CONFIG_TARGET_ROOTFS_PARTSIZE=24
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 开启 eMMC 物理驱动支持 (RootFS在NOR，eMMC作为数据盘)
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_block-mount=y

# 文件系统支持 (适配 eMMC 高速读写)
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_parted=y

# --- 4. 内存与性能硬化 (物理架构锁定) ---
CONFIG_ARCH_64BIT=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y

# --- 5. 网络加速与驱动 ---
CONFIG_PACKAGE_kmod-mtk-eth-warp=y
CONFIG_PACKAGE_kmod-mtk-ppe=y

# --- 6. 无线与隔离 (解决 WPAD 物理冲突) ---
CONFIG_PACKAGE_wpad-mesh-openssl=y
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-basic is not set

# --- 7. UI 与基本中文环境 ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-easymesh=y

# --- 8. 质量控制与调试 ---
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_USE_SSTRIP=y
