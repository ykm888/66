# =================================================================
# 1. 目标平台物理锁定 (修复 EMMC 冲突)
# =================================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# 核心修正：锁定为 SPI-NOR 运行目标，确保与 Makefile/DTS 物理对齐
# CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-emmc is not set
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-spi-nor=y

# =================================================================
# 2. 1GB 大内存满血优化 (内核级限制解除)
# =================================================================
CONFIG_TARGET_RAM_SIZE_1024=y
# 彻底关闭低内存足迹模式，释放 1GB 内存的缓存潜力
CONFIG_LOW_MEMORY_FOOTPRINT=n
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_PRINTK=y

# =================================================================
# 3. 32MB SPI-NOR 存储空间压制 (体积优化策略)
# =================================================================
# 强制使用 Os 优化（优化体积），而非 Ot（优化性能）
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -march=armv8-a+crypto+crc"
# 移除冗余内核调试符号表 (节省约 1MB+)
CONFIG_KMOD_SYMTAB=n
# 强制压缩内核
CONFIG_KERNEL_GZIP=y
CONFIG_CLEAN_IPKG=y
CONFIG_STRIP_KERNEL_EXPORTS=y

# =================================================================
# 4. 物理硬件驱动：无线与网口 (MT7981B + MT7976)
# =================================================================
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt798x-phy-mt7976=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_wpad-openssl=y
# 核心 Wi-Fi 闭源/开源管理工具
CONFIG_PACKAGE_luci-app-mtwifi=y

# =================================================================
# 5. 移除所有 USB 相关逻辑 (物理减重，节省 2MB+)
# =================================================================
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set

# =================================================================
# 6. 救砖全家桶必备工具 (物理层调试)
# =================================================================
# 允许读写只读分区 (救砖修改 Bootloader 必备)
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_mtd-utils-flashcp=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_fdisk=y
# 增加 Hex 查看工具，方便在 TTYD 终端审计 Flash 偏移量
CONFIG_PACKAGE_hexdump=y

# =================================================================
# 7. 基础 UI 与轻量化插件
# =================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# 网页终端：救砖时无需串口线即可操作 mtd
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
