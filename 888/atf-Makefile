# SPDX-License-Identifier: GPL-2.0-only
# SL-3000 (MT7981) Physical Hardening Makefile
# Target: 1MB FIP Offset + DDR4 Support

include $(TOPDIR)/rules.mk

PKG_NAME:=arm-trusted-firmware-mediatek
PKG_VERSION:=23.05-sl3000
PKG_RELEASE:=1

# 物理溯源：锁定你个人的干净源码仓库与救砖分支
PKG_SOURCE_PROTO:=git
PKG_SOURCE_URL:=https://github.com/ykm888/66.git
PKG_SOURCE_VERSION:=sl3000-clean-source
PKG_MIRROR_HASH:=skip

PKG_LICENSE:=BSD-3-Clause
PKG_LICENSE_FILES:=docs/license.rst

# 引用 OpenWrt TFA 构建框架
include $(INCLUDE_DIR)/trusted-firmware-a.mk
include $(INCLUDE_DIR)/package.mk

# 默认基础配置
define Trusted-Firmware-A/Default
  BUILD_TARGET:=mediatek
  BUILD_SUBTARGET:=filogic
  PLAT:=mt7981
  TFA_IMAGE:=bl2.img fip.bin
endef

# 物理定义：SL-3000 专属变体 (NOR 启动 + DDR4 内存)
# 此名称必须与 Workflow 中的 CONFIG_PACKAGE_... 一致
define Trusted-Firmware-A/mt7981-sl3000-nor
  NAME:=SL-3000 (NOR-DDR4-1MB-Fix)
  BUILD_DEVICES:=mediatek_mt7981-rfb-flash
  TFA_MAKE_FLAGS:= \
    BOOT_DEVICE=nor \
    DRAM_USE_DDR4=1 \
    DEBUG=0
endef

# 物理导出变体列表
TFA_TARGETS:=mt7981-sl3000-nor

# 物理钩子：在源码准备好后执行，确保 prepare 阶段逻辑纯净
# 实际的文件注入（cp 888 零件）将由外部 diy-part2.sh 在本阶段后强力拉起
define Build/Prepare
	$(call Build/Prepare/Default)
	@echo "Makefile: Source for $(PKG_NAME) is ready. Waiting for diy-part2.sh injection."
endef

$(eval $(call BuildPackage/Trusted-Firmware-A))
