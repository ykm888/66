include $(TOPDIR)/rules.mk

PKG_NAME:=arm-trusted-firmware-mediatek
PKG_VERSION:=sl3000-c
PKG_RELEASE:=1

PKG_SOURCE_PROTO:=git
PKG_SOURCE_URL:=https://github.com/ykm888/66.git
PKG_SOURCE_VERSION:=sl3000-clean-source

PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)-$(BUILD_VARIANT)

include $(INCLUDE_DIR)/kernel.mk
include $(INCLUDE_DIR)/trusted-firmware-a.mk
include $(INCLUDE_DIR)/package.mk

define Trusted-Firmware-A/Default
  BUILD_TARGET:=mediatek
  BUILD_SUBTARGET:=filogic
  PLAT:=mt7981
  TFA_IMAGE:=bl2.img
endef

define Trusted-Firmware-A/mt7981-spim-nand-ddr4
  NAME:=SL-3000 (SPI-NOR/DDR4)
  BOOT_DEVICE:=nor
  DDR_TYPE:=ddr4
  MAKE_FLAGS += BOOT_DEVICE=nor DRAM_USE_DDR4=1 MTK_FIP_BASE=0x100000
endef

TFA_TARGETS:= mt7981-spim-nand-ddr4

define Build/Prepare
	$(call Build/Prepare/Default)
	# 物理心脏注入：强制覆盖源码目录
	mkdir -p $(PKG_BUILD_DIR)/plat/mediatek/mt7981/bl2/
	$(CP) $(TOPDIR)/888/bl2_dev_spi_nor.c $(PKG_BUILD_DIR)/plat/mediatek/mt7981/bl2/bl2_dev_spi_nor.c
	$(CP) $(TOPDIR)/888/platform_def.h $(PKG_BUILD_DIR)/plat/mediatek/mt7981/include/platform_def.h
	$(CP) $(TOPDIR)/888/platform.mk $(PKG_BUILD_DIR)/plat/mediatek/mt7981/platform.mk
endef

$(eval $(call BuildPackage/Trusted-Firmware-A))
