include $(TOPDIR)/rules.mk

PKG_NAME:=arm-trusted-firmware-mediatek
PKG_RELEASE:=1

# 物理溯源：锁定救砖专用源码
PKG_SOURCE_PROTO:=git
PKG_SOURCE_URL:=https://github.com/ykm888/66.git
PKG_SOURCE_VERSION:=sl3000-clean-source
PKG_MIRROR_HASH:=skip

include $(INCLUDE_DIR)/kernel.mk
include $(INCLUDE_DIR)/trusted-firmware-a.mk
include $(INCLUDE_DIR)/package.mk

# --- 零件工厂定义 ---
define Trusted-Firmware-A/Default
  BUILD_TARGET:=mediatek
  # 物理导出：确保输出 bl2.img，这是救砖的核心心脏
  TFA_IMAGE:=bl2.img
  HIDDEN:=1
endef

# --- 司络 SL-3000 专属 DDR4 零件 ---
define Trusted-Firmware-A/mt7981-nor-ddr4
  NAME:=SL-3000 (SPI-NOR/DDR4)
  BUILD_SUBTARGET:=filogic
  PLAT:=mt7981
  BOOT_DEVICE:=nor
  DDR_TYPE:=ddr4
  # 物理偏移锁定：1MB (0x100000)
  FIP_OFFSET:=0x100000
endef

TFA_TARGETS:= mt7981-nor-ddr4

# 物理修正：使用符合 trusted-firmware-a.mk 逻辑的包名注册
$(eval $(call BuildPackage,arm-trusted-firmware-mediatek))
# 物理追加：确保变体名在 defconfig 中物理可见
$(eval $(call BuildTrustedFirmwareA,mt7981-nor-ddr4))
